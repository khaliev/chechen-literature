{
  "name": "noxchiin-literature",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chechen literary portal — poetry, songs, and prose",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-data && vite build",
    "preview": "vite preview",
    "validate-data": "node scripts/validate-data.mjs",
    "generate-index": "node scripts/generate-index.mjs",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate-data && npm run lint && npm run test"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.10",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
